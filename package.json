{
  "name": "social-hub-frontend",
  "private": true,
  "description": "Build dos assets do Social Hub (Tailwind CSS, Lucide e fonte Inter).",
  "scripts": {
    "build:css": "tailwindcss -c frontend/tailwind.config.js -i frontend/input.css -o static/dist/css/app.css --minify",
    "build:vendor": "node frontend/copy-vendor.js",
    "build": "npm run build:css && npm run build:vendor",
    "watch": "tailwindcss -c frontend/tailwind.config.js -i frontend/input.css -o static/dist/css/app.css --watch"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.2.5",
    "lucide": "0.468.0",
    "tailwindcss": "3.4.17"
  }
}
