{
  "name": "social-hub-frontend",
  "private": true,
  "description": "Build dos assets do Social Hub (Tailwind CSS, Lucide e fonte Inter).",
  "scripts": {
    "build:css": "tailwindcss -c frontend/tailwind.config.js -i frontend/input.css -o static/dist/css/app.css --minify",
    "build:vendor": "node frontend/copy-vendor.js",
    "build": "npm run build:css && npm run build:vendor && npm run build:js",
    "watch": "tailwindcss -c frontend/tailwind.config.js -i frontend/input.css -o static/dist/css/app.css --watch",
    "build:js": "esbuild frontend/mui/index.jsx --bundle --minify --format=iife --jsx=automatic --define:process.env.NODE_ENV=\\\"production\\\" --outfile=static/dist/js/mui.js"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.2.5",
    "esbuild": "^0.28.2",
    "lucide": "0.468.0",
    "tailwindcss": "3.4.17"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
