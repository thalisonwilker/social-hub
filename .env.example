# Copie para .env (cp .env.example .env) e ajuste os valores.
# O arquivo .env NÃO deve ser versionado.

# --- Django ---
# Obrigatória em produção (mín. 32 caracteres). Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=troque-esta-chave-por-uma-gerada-com-no-minimo-32-caracteres
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Origens confiáveis para CSRF quando houver domínio/HTTPS (separe por vírgula).
# Ex.: https://hub.exemplo.com
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TIME_ZONE=America/Sao_Paulo
DJANGO_LOG_LEVEL=INFO

# --- HTTPS (ative apenas atrás de TLS, ex.: proxy reverso) ---
DJANGO_SECURE_SSL=false
DJANGO_BEHIND_PROXY=false

# --- Usuário administrador inicial (criado no primeiro start, se não existir) ---
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=troque-esta-senha
DJANGO_SUPERUSER_EMAIL=admin@example.com

# --- Meta (Facebook) --- veja specs/0002-facebook-page-connect/design.md
META_APP_ID=
META_APP_SECRET=
META_LOGIN_CONFIG_ID=
# Deve coincidir EXATAMENTE com a URI cadastrada no app Meta.
META_REDIRECT_URI=http://localhost:8000/contas/facebook/callback/
META_GRAPH_VERSION=v27.0
# Chave(s) Fernet (várias separadas por vírgula p/ rotação). Gere com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
META_TOKEN_ENCRYPTION_KEY=

# --- Threads --- veja specs/0004-threads-conectar-e-publicar/design.md
# Credenciais do caso de uso Threads (diferentes do App ID/Chave do app principal).
THREADS_APP_ID=
THREADS_APP_SECRET=
# HTTPS obrigatório (em desenvolvimento, use um túnel). Idêntica à URL cadastrada na Meta.
THREADS_REDIRECT_URI=https://seu-dominio-ou-tunel/contas/threads/callback/
THREADS_GRAPH_VERSION=v1.0
# Renova o token quando faltar menos que isso (dias); só renova após 24 h de vida.
THREADS_REFRESH_WINDOW_DAYS=30
# Tempo máximo esperando o container de texto ficar pronto (segundos).
THREADS_CONTAINER_WAIT_SECONDS=20

# --- Imagem no Threads --- veja specs/0005-threads-imagem/design.md
# Base HTTPS pela qual a Meta alcança o Hub para baixar a imagem. Vazio = origem do THREADS_REDIRECT_URI.
PUBLIC_BASE_URL=
# Validade da URL pública assinada da imagem (segundos).
THREADS_IMAGE_URL_TTL_SECONDS=1800
# Tempo máximo esperando o container de imagem ficar pronto (segundos).
THREADS_IMAGE_WAIT_SECONDS=60
# Instagram (spec 0009): espera do container de imagem, em segundos.
INSTAGRAM_CONTAINER_WAIT_SECONDS=60
# Orçamento de tempo de uma requisição de envio (segundos); deve ser menor que o --timeout do Gunicorn (180).
PUBLISH_REQUEST_BUDGET_SECONDS=150

# --- Publicações ---
# Lote de Páginas por requisição (5 uploads de até 30 s cabem no Gunicorn --timeout 180).
PUBLISH_BATCH_SIZE=5

# --- Docker ---
WEB_PORT=8000
GUNICORN_WORKERS=2

# --- Desenvolvimento local (sem Docker) ---
# DATABASE_PATH=./db.sqlite3

# --- WhatsApp (Status) via Evolution API ---------------------------------------------------------------
# Origem HTTPS da sua Evolution (só host; caminho como /manager é ignorado). Vazio = integração desligada.
# Use a chave da instância (uma por instância), digitada na tela de Contas do Hub (cifrada). Nunca use a chave global da Evolution.
# Aviso: o Baileys NÃO é oficial; envio frequente pode levar ao banimento do número.
EVOLUTION_API_URL=
EVOLUTION_TIMEOUT_SECONDS=120

# --- Publicação em segundo plano (worker) -------------------------------------------------------------
# `worker` (padrão em produção): Publicar só enfileira e o serviço `worker` envia. `inline`: envia na requisição (dev).
# PUBLISH_MODE=worker
# Pausa do worker sem fila (s), idade máxima da última batida para considerá-lo ativo (s) e
# tempo máximo de um alvo `sending` antes de virar Incerto (s).
WORKER_POLL_SECONDS=2
WORKER_HEARTBEAT_STALE_SECONDS=180
PUBLISH_SENDING_STALE_SECONDS=900

# --- Gerar imagem com IA (Google Gemini) ----------------------------------------------------------------
# Cada usuário cadastra a própria chave na tela de nova publicação (cifrada). GEMINI_API_KEY é só o fallback do servidor.
# GEMINI_API_KEY=
# Modelos de imagem oferecidos (o primeiro é o padrão); vazio desliga a seção. Confirme os IDs vigentes na documentação do Google.
# GEMINI_IMAGE_MODELS=gemini-nano-banana-2.1,gemini-3-pro-image,gemini-3.1-flash-image,gemini-2.5-flash-image
# GEMINI_TIMEOUT_SECONDS=90
# Modelo de texto usado para gerar o conteúdo da publicação (vazio desliga o painel). Confirme o ID vigente no Google.
# GEMINI_TEXT_MODEL=gemini-2.5-flash
# DeepSeek como segundo provedor de texto (chave por usuário na tela; DEEPSEEK_API_KEY é só fallback). Vazio desliga.
# DEEPSEEK_API_KEY=
# DEEPSEEK_TEXT_MODEL=deepseek-chat

# --- E-mail (recuperação de senha, spec 0016) -------------------------------------------------------
# Sem EMAIL_HOST os e-mails são gravados em var/emails/ (desenvolvimento). Em produção configure o SMTP.
# EMAIL_HOST=smtp.seu-provedor.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# DEFAULT_FROM_EMAIL=Social Hub <nao-responda@seu-dominio.com>
# Os links do e-mail usam PUBLIC_BASE_URL (acima) quando definido; vazio = origem da requisição.
