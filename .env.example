# Copie para .env (cp .env.example .env) e ajuste os valores.
# O arquivo .env NÃO deve ser versionado.

# --- Django ---
# Obrigatória em produção (mín. 32 caracteres). Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=troque-esta-chave-por-uma-gerada-com-no-minimo-32-caracteres
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Origens confiáveis para CSRF quando houver domínio/HTTPS (separe por vírgula).
# Ex.: https://hub.exemplo.com
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TIME_ZONE=America/Sao_Paulo
DJANGO_LOG_LEVEL=INFO

# --- HTTPS (ative apenas atrás de TLS, ex.: proxy reverso) ---
DJANGO_SECURE_SSL=false
DJANGO_BEHIND_PROXY=false

# --- Usuário administrador inicial (criado no primeiro start, se não existir) ---
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=troque-esta-senha
DJANGO_SUPERUSER_EMAIL=admin@example.com

# --- Docker ---
WEB_PORT=8000
GUNICORN_WORKERS=2

# --- Desenvolvimento local (sem Docker) ---
# DATABASE_PATH=./db.sqlite3
